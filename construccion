  <div class="container"><div class="card cta reveal"><div class="kicker">Conversemos</div><h2 class="title">Tu próximo espacio puede empezar con una buena decisión de diseño.</h2><p>Cuéntanos qué quieres construir o transformar y evaluemos juntos la mejor forma de llevarlo a proyecto.</p><a href="#cotizador" class="btn btn-primary">Solicitar cotización</a></div></div>
</section>

<footer><div class="container footer-grid"><div><span class="footer-brand brand">ARQ<span>MODULAR</span></span><br>Arquitectura modular & espacios comerciales.</div><div>La Araucanía · Chile<br>© <span id="year"></span> ARQMODULAR</div></div></footer>
<a class="whatsapp" href="#cotizador" aria-label="Ir al cotizador">W</a>

<script>
(function(){
  'use strict';
  const WHATSAPP_NUMBER='56912345678'; // REEMPLAZAR POR EL NÚMERO REAL, SIN + NI ESPACIOS.
  const menuBtn=document.getElementById('menuBtn');
  const navLinks=document.getElementById('navLinks');
  menuBtn.addEventListener('click',()=>navLinks.classList.toggle('open'));
  navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>navLinks.classList.remove('open')));

  document.querySelectorAll('.filter').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      const filter=btn.dataset.filter;
      document.querySelectorAll('.project').forEach(card=>{
        card.style.display=(filter==='todos'||card.dataset.category===filter)?'block':'none';
      });
    });
  });

  const type=document.getElementById('type');
  const model=document.getElementById('model');
  const models={
    tiny:['Modelo Villarrica Panorama (24 m²)','Refugio Llaima (28 m²)','Studio Modular (15 m²)','Proyecto personalizado'],
    comercial:['Módulo Gastronómico / Cafetería','Habilitación de Local Comercial','Oficina / Showroom Modular','Proyecto comercial personalizado']
  };
  type.addEventListener('change',()=>{
    model.innerHTML='<option value="">Selecciona</option>';
    (models[type.value]||[]).forEach(text=>{const op=document.createElement('option');op.value=text;op.textContent=text;model.appendChild(op)});
  });

  document.getElementById('quoteForm').addEventListener('submit',function(e){
    e.preventDefault();
    if(!this.reportValidity()) return;
    const projectType=type.options[type.selectedIndex].text;
    const message=[
      'Hola, mi nombre es '+document.getElementById('name').value.trim()+'.',
      '',
      'Me gustaría solicitar información para cotizar un proyecto con ARQMODULAR.',
      '',
      '• Tipo: '+projectType,
      '• Modelo / Formato: '+model.value,
      '• Ubicación: '+document.getElementById('location').value.trim(),
      '• Teléfono: '+(document.getElementById('phone').value.trim()||'No indicado'),
      '• Plazo estimado: '+document.getElementById('timeframe').value,
      '• Detalles: '+(document.getElementById('details').value.trim()||'Sin detalles adicionales'),
      '',
      '¿Podrían orientarme sobre los próximos pasos?'
    ].join('\n');
    const url='https://wa.me/'+WHATSAPP_NUMBER+'?text='+encodeURIComponent(message);
    document.getElementById('success').style.display='block';
    window.open(url,'_blank','noopener,noreferrer');
  });

  const reveal=()=>document.querySelectorAll('.reveal').forEach(el=>{if(el.getBoundingClientRect().top<window.innerHeight-60)el.classList.add('visible')});
  reveal();window.addEventListener('scroll',reveal,{passive:true});
  document.getElementById('year').textContent=new Date().getFullYear();
})();
</script>
</body>
</html>
