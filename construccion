.section{padding:100px 0;border-top:1px solid var(--line)}
.section-head{max-width:760px;margin-bottom:48px}.section-head h2{font-size:clamp(2.1rem,5vw,4.2rem);margin:10px 0 18px}.section-head p{color:var(--muted);font-size:1.05rem}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 22px;border-radius:999px;border:1px solid transparent;font-size:.82rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;transition:.25s}
.btn-primary{background:var(--gold);color:#101010}.btn-primary:hover{background:var(--gold2);transform:translateY(-2px)}
.btn-ghost{border-color:rgba(255,255,255,.22)}.btn-ghost:hover{border-color:var(--gold);color:var(--gold)}
.card{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
nav{position:fixed;inset:0 0 auto 0;z-index:50;background:rgba(10,10,10,.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav-inner{height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-family:Georgia,'Times New Roman',serif;font-size:1.4rem;font-weight:700;letter-spacing:.08em}.brand span{color:var(--gold)}
.nav-links{display:flex;align-items:center;gap:24px;font-size:.74rem;text-transform:uppercase;letter-spacing:.12em;color:#c9c5be}.nav-links a:hover{color:var(--gold)}
.menu-btn{display:none;background:transparent;color:white;border:1px solid var(--line);padding:10px 12px;border-radius:10px}
.hero{min-height:100vh;padding:138px 0 70px;display:grid;place-items:center;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;inset:-30%;background:radial-gradient(circle at 70% 30%,rgba(200,160,111,.23),transparent 28%),radial-gradient(circle at 20% 80%,rgba(255,255,255,.05),transparent 24%);pointer-events:none}
.hero-grid{position:absolute;inset:0;opacity:.16;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(to bottom,black,transparent)}
.hero-inner{position:relative;z-index:2;text-align:center;max-width:980px}
.hero h1{font-size:clamp(3rem,8vw,7rem);margin:18px 0 24px}.hero h1 em{color:var(--gold);font-weight:500}
.hero p{max-width:780px;margin:0 auto 34px;color:#bbb5ad;font-size:clamp(1rem,2vw,1.22rem)}
.hero-actions{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}.hero-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:64px;text-align:left}.hero-meta div{padding:20px;border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:16px}.hero-meta strong{display:block;color:var(--gold);font-size:1.1rem}.hero-meta span{color:#96918a;font-size:.86rem}
.about-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:stretch}.about-copy{padding:38px}.about-copy h3{font-size:2rem;margin-bottom:18px}.about-copy p{color:var(--muted);margin-bottom:14px}.about-visual{min-height:420px;padding:34px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}.about-visual:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(200,160,111,.18),transparent 42%),repeating-linear-gradient(90deg,transparent 0 78px,rgba(255,255,255,.04) 79px 80px)}.about-visual>*{position:relative}.about-visual .arch{height:230px;border:1px solid rgba(255,255,255,.18);border-radius:18px 18px 4px 4px;background:linear-gradient(145deg,#242424,#101010);position:relative;overflow:hidden}.arch:after{content:"";position:absolute;left:12%;right:12%;bottom:12%;height:52%;border:1px solid var(--gold);background:linear-gradient(90deg,rgba(200,160,111,.12),rgba(255,255,255,.02))}.about-visual h4{font-family:Georgia,serif;font-size:1.6rem;margin-top:24px}.about-visual p{color:var(--muted)}
.mv-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.mv{padding:34px}.mv h3{font-family:Georgia,serif;font-size:1.85rem;margin:10px 0 14px}.mv p{color:var(--muted)}
.values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.value{padding:26px;min-height:220px}.value .num{color:var(--gold);font:700 1rem Georgia,serif}.value h3{font-family:Georgia,serif;font-size:1.35rem;margin:34px 0 10px}.value p{color:var(--muted);font-size:.94rem}
.services{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.service{padding:34px}.service .icon{width:52px;height:52px;border:1px solid rgba(200,160,111,.35);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:1.5rem}.service h3{font-family:Georgia,serif;font-size:1.8rem;margin:22px 0 12px}.service p{color:var(--muted);margin-bottom:20px}.service ul{list-style:none;display:grid;gap:10px;color:#d4d0c9;font-size:.94rem}.service li:before{content:"✓";color:var(--gold);margin-right:10px}
.projects-controls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px}.filter{background:transparent;border:1px solid var(--line);color:#aaa;padding:10px 16px;border-radius:999px}.filter.active,.filter:hover{border-color:var(--gold);color:var(--gold)}
.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.project{overflow:hidden}.project-media{height:300px;background:linear-gradient(135deg,#282828,#0f0f0f);position:relative;display:grid;place-items:center;overflow:hidden}.project-media img{width:100%;height:100%;object-fit:cover}.project-media .fallback{position:absolute;inset:0;display:grid;place-items:center;font-family:Georgia,serif;font-size:3rem;color:rgba(200,160,111,.5);background:radial-gradient(circle at 60% 30%,rgba(200,160,111,.18),transparent 30%),repeating-linear-gradient(120deg,transparent 0 38px,rgba(255,255,255,.025) 39px 40px)}.project-info{padding:24px}.project-info small{color:var(--gold);text-transform:uppercase;letter-spacing:.14em}.project-info h3{font-family:Georgia,serif;font-size:1.45rem;margin-top:7px}.project-info p{color:var(--muted);margin-top:8px;font-size:.92rem}
.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.step{padding:26px}.step b{font-family:Georgia,serif;color:var(--gold);font-size:2rem}.step h3{margin:22px 0 8px}.step p{color:var(--muted);font-size:.92rem}
.why-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px}.why-big{padding:36px;display:flex;flex-direction:column;justify-content:flex-end;min-height:430px;background:linear-gradient(145deg,#1f1b17,#111)}.why-big h3{font-family:Georgia,serif;font-size:2.5rem;margin-bottom:14px}.why-big p{color:var(--muted)}.why-list{display:grid;gap:16px}.why-item{padding:24px}.why-item strong{display:block;color:var(--gold);margin-bottom:7px}.why-item p{color:var(--muted)}
.quote{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;align-items:start}.quote-intro{padding:36px;position:sticky;top:110px}.quote-intro h2{font-size:3rem;margin:12px 0 18px}.quote-intro p{color:var(--muted)}
.form{padding:32px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:8px}.field.full{grid-column:1/-1}.field label{font-size:.76rem;text-transform:uppercase;letter-spacing:.12em;color:#c6c1b9}.field input,.field select,.field textarea{width:100%;background:#0e0e0e;color:white;border:1px solid var(--line);border-radius:12px;padding:14px 15px;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold)}.field textarea{min-height:110px;resize:vertical}.form-note{color:#8f8a83;font-size:.83rem;margin:16px 0 20px}.success{display:none;margin-top:16px;padding:14px;border:1px solid rgba(200,160,111,.35);background:rgba(200,160,111,.08);border-radius:12px;color:#e8d1b3}
.faq{display:grid;gap:12px}.faq details{padding:20px 22px}.faq summary{cursor:pointer;font-weight:700}.faq p{color:var(--muted);padding-top:12px}
.cta{padding:54px;text-align:center;background:radial-gradient(circle at 50% 0%,rgba(200,160,111,.16),transparent 38%),linear-gradient(180deg,#171717,#101010)}.cta h2{font-size:clamp(2.3rem,5vw,4.6rem);margin:10px auto 20px;max-width:850px}.cta p{color:var(--muted);max-width:680px;margin:0 auto 28px}
footer{padding:44px 0;border-top:1px solid var(--line);color:#8d8982;font-size:.85rem}.footer-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}.footer-brand{color:#eee}
.whatsapp{position:fixed;right:22px;bottom:22px;z-index:40;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#25D366;color:white;box-shadow:0 14px 36px rgba(0,0,0,.38);font-weight:900;font-size:1.25rem;border:3px solid rgba(255,255,255,.15)}
.reveal{opacity:0;transform:translateY(18px);transition:.65s}.reveal.visible{opacity:1;transform:none}
@media(max-width:950px){.nav-links{display:none;position:absolute;left:20px;right:20px;top:86px;flex-direction:column;align-items:stretch;background:#111;border:1px solid var(--line);border-radius:16px;padding:18px}.nav-links.open{display:flex}.menu-btn{display:block}.hero-meta,.values-grid,.process-grid{grid-template-columns:repeat(2,1fr)}.about-grid,.why-grid,.quote{grid-template-columns:1fr}.quote-intro{position:static}.services,.projects,.mv-grid{grid-template-columns:1fr}}
@media(max-width:620px){.container{width:min(100% - 28px,var(--max))}.section{padding:76px 0}.hero{padding-top:118px}.hero-meta,.values-grid,.process-grid,.form-grid{grid-template-columns:1fr}.hero h1{font-size:3.3rem}.about-copy,.about-visual,.service,.mv,.form,.quote-intro{padding:24px}.cta{padding:34px 22px}.project-media{height:220px}.whatsapp{width:52px;height:52px;right:15px;bottom:15px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>
<nav>
  <div class="container nav-inner">
    <a href="#inicio" class="brand">ARQ<span>MODULAR</span></a>
    <button class="menu-btn" id="menuBtn" aria-label="Abrir menú">☰</button>
    <div class="nav-links" id="navLinks">
      <a href="#nosotros">Nosotros</a><a href="#servicios">Servicios</a><a href="#proyectos">Proyectos</a><a href="#proceso">Proceso</a><a href="#cotizador">Cotizar</a>
